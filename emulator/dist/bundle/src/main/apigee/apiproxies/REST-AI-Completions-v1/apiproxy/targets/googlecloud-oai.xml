<TargetEndpoint name="googlecloud-oai">
  <HTTPTargetConnection>
    <Properties/>
    <URL>https://aiplatform.googleapis.com/v1/projects/{ai.googleCloudProject}/locations/global/endpoints/openapi/chat/completions</URL>
  </HTTPTargetConnection>
  <PreFlow name="PreFlow">
    <Request/>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response>
      <Step>
        <Name>JS-Analytics</Name>
        <Condition>response.content != ""</Condition>
      </Step>
      <Step>
        <Name>DC-TokenAnalytics</Name>
        <Condition>ai.usageDataFound = "true"</Condition>
      </Step>
      <Step>
        <Name>JS-ResetUsageDataFound</Name>
        <Condition>ai.usageDataFound = "true"</Condition>
      </Step>
    </Response>
  </PostFlow>
  <EventFlow name="EventFlow" content-type="text/event-stream">
    <Response>
      <Step>
        <Name>JS-Analytics</Name>
      </Step>
      <Step>
        <Name>DC-TokenAnalytics</Name>
        <Condition>ai.usageDataFound = "true"</Condition>
      </Step>
      <Step>
        <Name>JS-ResetUsageDataFound</Name>
        <Condition>ai.usageDataFound = "true"</Condition>
      </Step>
    </Response>
  </EventFlow>
</TargetEndpoint>