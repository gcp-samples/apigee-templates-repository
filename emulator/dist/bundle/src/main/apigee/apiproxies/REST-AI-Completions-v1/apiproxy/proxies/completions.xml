<ProxyEndpoint name="completions">
  <HTTPProxyConnection>
    <BasePath>/v1/chat/completions</BasePath>
  </HTTPProxyConnection>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>OAS-Validation</Name>
      </Step>
      <Step>
        <Name>KVM-LoadConfig</Name>
      </Step>
      <Step>
        <Name>AM-SetVariables</Name>
      </Step>
      <Step>
        <Name>JS-CheckModel</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <RouteRule name="route-googlecloud">
    <TargetEndpoint>googlecloud</TargetEndpoint>
    <Condition>target.route = "googlecloud"</Condition>
  </RouteRule>
  <RouteRule name="route-googlecloud-oai">
    <TargetEndpoint>googlecloud-oai</TargetEndpoint>
    <Condition>target.route = "googlecloud-oai"</Condition>
  </RouteRule>
  <RouteRule name="route-openai">
    <TargetEndpoint>openai</TargetEndpoint>
    <Condition>target.route = "openai"</Condition>
  </RouteRule>
  <RouteRule name="route-anthropic">
    <TargetEndpoint>anthropic</TargetEndpoint>
    <Condition>target.route = "anthropic"</Condition>
  </RouteRule>
  <RouteRule name="default">
    <TargetEndpoint>googlecloud</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>