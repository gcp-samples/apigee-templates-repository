<DataCapture name="DC-TokenAnalytics" continueOnError="false" enabled="true">
  <DisplayName>DC-TokenAnalytics</DisplayName>
  <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
  <Capture>
    <Collect ref="ai.model" default="unknown"/>
    <DataCollector>dc_ai_model</DataCollector>
  </Capture>
  <Capture>
    <Collect ref="ai.promptTokenCount" default="0"/>
    <DataCollector>dc_ai_prompt_token_count</DataCollector>
  </Capture>
  <Capture>
    <Collect ref="ai.responseTokenCount" default="0"/>
    <DataCollector>dc_ai_response_token_count</DataCollector>
  </Capture>
  <Capture>
    <Collect ref="ai.totalTokenCount" default="0"/>
    <DataCollector>dc_ai_total_token_count</DataCollector>
  </Capture>
  <Capture>
    <Collect ref="ai.responseType" default="unknown"/>
    <DataCollector>dc_ai_response_type</DataCollector>
  </Capture>
  <Capture>
    <Collect ref="ai.timeToFirstToken" default="0"/>
    <DataCollector>dc_ai_time_first_token</DataCollector>
  </Capture>
  <Capture>
    <Collect ref="ai.costCenter" default="unknown"/>
    <DataCollector>dc_ai_cost_center</DataCollector>
  </Capture>
  <Capture>
    <Collect ref="ai.requestCost" default="0"/>
    <DataCollector>dc_ai_request_cost</DataCollector>
  </Capture>
  <Capture>
    <Collect ref="ai.responseCost" default="0"/>
    <DataCollector>dc_ai_response_cost</DataCollector>
  </Capture>
  <Capture>
    <Collect ref="ai.totalCost" default="0"/>
    <DataCollector>dc_ai_total_cost</DataCollector>
  </Capture>
</DataCapture>