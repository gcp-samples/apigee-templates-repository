<TargetEndpoint name="gemini">
  <HTTPTargetConnection>
    <Properties>
      <Property name="io.timeout.millis">18000000</Property>
    </Properties>
    <URL>https://generativelanguage.googleapis.com/v1beta/models</URL>
  </HTTPTargetConnection>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>KVM-LoadCredentials</Name>
      </Step>
      <Step>
        <Name>AM-SetHeader</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response>
      <Step>
        <Name>JS-Analytics</Name>
        <Condition>response.content != ""</Condition>
      </Step>
      <Step>
        <Name>DC-TokenAnalytics</Name>
        <Condition>ai.usageDataFound = "true"</Condition>
      </Step>
      <Step>
        <Name>JS-ResetUsageDataFound</Name>
        <Condition>ai.usageDataFound = "true"</Condition>
      </Step>
    </Response>
  </PostFlow>
  <EventFlow name="EventFlow" content-type="text/event-stream">
    <Response>
      <Step>
        <Name>JS-Analytics</Name>
      </Step>
      <Step>
        <Name>DC-TokenAnalytics</Name>
        <Condition>ai.usageDataFound = "true"</Condition>
      </Step>
      <Step>
        <Name>JS-ResetUsageDataFound</Name>
        <Condition>ai.usageDataFound = "true"</Condition>
      </Step>
    </Response>
  </EventFlow>
</TargetEndpoint>