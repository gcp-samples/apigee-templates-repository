<ProxyEndpoint name="gemini">
  <HTTPProxyConnection>
    <BasePath>/v1/models</BasePath>
  </HTTPProxyConnection>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>KVM-LoadConfig</Name>
      </Step>
      <Step>
        <Name>AM-SetVariables</Name>
      </Step>
      <Step>
        <Name>JS-CheckModel</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <RouteRule name="default">
    <TargetEndpoint>gemini</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>